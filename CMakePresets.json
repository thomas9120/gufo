{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GUFO_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Production gfx1151 build; same optimization as the Nix package",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "OFF",
        "ENGINE_ENABLE_HIP": "ON"
      }
    },
    {
      "name": "cpu-sanitizer",
      "displayName": "CPU Sanitizer",
      "description": "CPU-only build with AddressSanitizer and UndefinedBehaviorSanitizer enabled",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "GUFO_ENABLE_SANITIZERS": "ON",
        "ENGINE_ENABLE_HIP": "OFF"
      }
    },
    {
      "name": "cpu-test",
      "displayName": "CPU Tests",
      "description": "CPU-only build for running unit and smoke tests with CTest",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "ENGINE_ENABLE_HIP": "OFF"
      }
    },
    {
      "name": "gpu-test",
      "displayName": "gfx1151 GPU Tests",
      "description": "Optimized correctness build with debug symbols and active test assertions",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "ENGINE_ENABLE_HIP": "ON",
        "GUFO_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "windows-cpu",
      "displayName": "Windows CPU integration checks",
      "inherits": "cpu-test",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-gpu",
      "displayName": "Windows gfx1151 GPU build",
      "inherits": "gpu-test",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "release"
    },
    {
      "name": "cpu-sanitizer",
      "displayName": "CPU Sanitizer",
      "configurePreset": "cpu-sanitizer"
    },
    {
      "name": "cpu-test",
      "displayName": "CPU Tests",
      "configurePreset": "cpu-test"
    },
    {
      "name": "gpu-test",
      "displayName": "gfx1151 GPU Tests",
      "configurePreset": "gpu-test"
    },
    {
      "name": "pr",
      "configurePreset": "cpu-test",
      "targets": [
        "check-pr"
      ]
    },
    {
      "name": "windows-gpu",
      "configurePreset": "windows-gpu",
      "targets": [
        "gufo-server"
      ]
    },
    {
      "name": "windows-cpu",
      "configurePreset": "windows-cpu",
      "targets": [
        "gufo-server",
        "arg_parser_test",
        "gguf_reader_test",
        "gguf_identity_test",
        "win32_compat_test",
        "win32_filesystem_test",
        "win32_disk_store_test",
        "win32_host_test",
        "json_test",
        "json_constraint_test",
        "http_server_test",
        "audio_websocket_test"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "cpu-sanitizer",
      "displayName": "CPU ASan and UBSan Tests",
      "configurePreset": "cpu-sanitizer",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-test",
      "displayName": "CPU Tests",
      "configurePreset": "cpu-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "cpu"
        }
      }
    },
    {
      "name": "gpu-full",
      "displayName": "All gfx1151 GPU Tests",
      "configurePreset": "gpu-test",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gpu-fast",
      "displayName": "Fast gfx1151 GPU Tests",
      "configurePreset": "gpu-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "slow|external-model"
        }
      }
    },
    {
      "name": "deepseek-gpu",
      "displayName": "DeepSeek V4 Flash Checks",
      "configurePreset": "gpu-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "ds4"
        }
      }
    },
    {
      "name": "qwen-gpu-kernel-oracle",
      "displayName": "Qwen Comprehensive GPU Kernel Oracle",
      "configurePreset": "gpu-test",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "qwen-kernel-oracle"
        }
      }
    },
    {
      "name": "windows-cpu",
      "configurePreset": "windows-cpu",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(gufo_version|gufo_help|arg_parser_test|gguf_reader_test|gguf_identity_test|win32_compat_test|win32_filesystem_test|win32_disk_store_test|win32_host_test|json_test|json_constraint_test|cache_boundary_test|http_server_test|audio_websocket_test|win32_server_shutdown_test|win32_queue_policy_test)$"
        }
      }
    }
  ]
}
